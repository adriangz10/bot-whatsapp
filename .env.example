# Base de datos
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=
# Solo desarrollo local; en cualquier otro caso usar `npm run migrate`
DB_SYNCHRONIZE=false
# 'Z' guarda las fechas en UTC; vacío = hora local del proceso (comportamiento anterior)
DB_TIMEZONE=
# Días de retención de mensajes; vacío o 0 = no borrar nunca
MESSAGE_RETENTION_DAYS=

# Seguridad
# Clave para los endpoints de administración y el WebSocket (header x-api-key o Bearer; ?token= en WS)
ADMIN_API_KEY=
# Orígenes permitidos por CORS, separados por comas (ej: https://panel.midominio.com)
CORS_ORIGINS=

# IA
GEMINI_API_KEY=
OPENAI_API_KEY=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# App Secret de la app de Meta: habilita la validación de la firma X-Hub-Signature-256
WHATSAPP_APP_SECRET=

# Google
GOOGLE_DOCS_DOCUMENT_ID=
# Minutos entre recargas del Doc (cambios sin reiniciar). Por defecto 5
GOOGLE_DOCS_RELOAD_MINUTES=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TIME_ZONE=America/Argentina/Buenos_Aires
GOOGLE_CREDENTIALS=
TZ=America/Argentina/Buenos_Aires
